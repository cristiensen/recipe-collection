# PostgreSQL connection string. Locally, use the URL `npm run db:local`
# prints, so development and e2e runs don't use (and get billed on) the
# hosted database; set the hosted one (Prisma Postgres, Neon, ...) in Vercel.
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Auth.js signing secret — generate with: npx auth secret
AUTH_SECRET=""

# Vercel Blob, authenticated with Vercel OIDC. Connecting a Blob store to the
# project adds these; locally, `npx vercel env pull .env.local` fetches them
# along with VERCEL_OIDC_TOKEN (expires after ~12 h, pull again when it does).
# Leave unset in development to store uploads in ./.uploads instead.
# Required in production.
BLOB_STORE_ID=""
BLOB_WEBHOOK_PUBLIC_KEY=""

# Public site URL used for social preview links (optional on Vercel)
# NEXT_PUBLIC_SITE_URL="https://recipes.example.com"

# Lets Vercel Cron call /api/cron/prune-views (daily cleanup of old view
# counts). Any long random string; required for the cleanup to run.
CRON_SECRET=""
