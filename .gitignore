# See https://git-scm.com/docs/gitignore for the pattern syntax.

# ─── Dependencies ───
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Next.js / build output ───
/.next/
/out/
/build
/dist
.turbo

# ─── TypeScript ───
*.tsbuildinfo
# Regenerated by `next dev` / `next build`
next-env.d.ts

# ─── Prisma ───
# Generated client (`prisma generate` runs on install and build).
# Migrations in prisma/migrations ARE committed.
/src/generated/prisma

# ─── Environment / secrets ───
# Real secrets live in .env / .env.local and Vercel's project settings.
.env*
*.env*
!.env.example
*.pem
*.key

# ─── Vercel ───
.vercel

# ─── Local data ───
# Development media uploads (used when BLOB_READ_WRITE_TOKEN isn't set)
/.uploads

# ─── Testing ───
/coverage
# Playwright
/test-results
/playwright-report
/blob-report
/playwright/.cache
# Vitest
/.vitest

# ─── Logs ───
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Editors / IDEs ───
.idea/
*.swp
*.swo
*~
# VS Code: keep shared settings, ignore personal ones
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# ─── AI coding tools (personal files only) ───
# The skills in .claude/, .agents/ and .windsurf/ are shared project setup
# (pinned by skills-lock.json) and are committed.
.claude/settings.local.json
CLAUDE.local.md

# ─── Operating systems ───
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─── Temporary files ───
*.tmp
*.tmp.*
.cache/
